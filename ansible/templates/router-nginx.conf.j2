server {
    listen {{ api_port }};

    location / {
        proxy_pass http://{{ api_ip }}:{{ api_port }};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }
}

server {
    listen {{ swagger_port }};

    location / {
        proxy_pass http://{{ swagger_ip }}:{{ swagger_port }};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }
}